    "T6" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Fri" } } } },
    "T7" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sat" } } } },
    "CN" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sun" } } } },
    "Khung giờ" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Time window" } } } },
