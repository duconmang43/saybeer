{
  "sourceLanguage" : "vi",
  "strings" : {
    "Hãy say bia.\nXin đừng “say” bậy." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drink tonight.\nText tomorrow." } } } },
    "Hãy say bia. Xin đừng “say” bậy." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drink tonight. Text tomorrow." } } } },
    "%lld phiên an toàn · %@ giờ đã khóa" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld safe sessions · %@ hrs locked" } } } },
    "Tự khóa %@ lúc %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto-locks %1$@ at %2$@" } } } },
    "Bắt đầu chế độ nhậu" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Beer Mode" } } } },
    "Hẹn lịch" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Schedule" } } } },
    "Thống kê" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stats" } } } },
    "Đang kiểm tra quyền Screen Time…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking Screen Time permission…" } } } },
    "Cửa sổ nhắn việc đang mở" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Work window open" } } } },
    "Đang khóa %lld mục" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Locking %lld items" } } } },
    "Khóa lại sau %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Locks again in %@" } } } },
    "Nhắn việc xong thì thôi nhé. Không tâm sự." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Work texts only. No feelings." } } } },
    "Tự mở khóa lúc %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto-unlocks at %@" } } } },
    "Thông báo của app bị khóa vẫn hiện trên màn hình khóa — đọc thoải mái." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications from locked apps still show up — read away." } } } },
    "Cần nhắn việc — mở %lld phút (còn %lld lần)" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Work text needed — open %1$lld min (%2$lld left)" } } } },
    "Tỉnh rồi — mở khóa hẳn" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sober now — unlock fully" } } } },
    "Khẩn cấp" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Emergency" } } } },
    "Chưa có quyền Screen Time" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Screen Time permission" } } } },
    "SayBeer cần quyền Screen Time để khóa app.\nVào Cài đặt → SayBeer để cấp quyền, hoặc mở lại app." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "SayBeer needs Screen Time permission to lock apps.\nGo to Settings → SayBeer to grant it, or reopen the app." } } } },
    "Cách hoạt động" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "How it works" } } } },
    "Quyền Screen Time" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Screen Time permission" } } } },
    "Khóa app nhắn tin trước khi đi, mở lại đúng giờ hẹn." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lock your messaging apps before you go out. They unlock right on schedule." } } } },
    "Chọn app cần khóa, hẹn giờ mở — tới giờ tự gỡ." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pick apps to lock and set an unlock time — it lifts automatically." } } } },
    "Cần nhắn việc? Mở tạm %lld phút, tối đa %lld lần." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Need to text for work? Open a %1$lld-minute window, up to %2$lld times." } } } },
    "Mở sớm phải gõ đúng câu líu lưỡi. Khẩn cấp thật thì giữ nút 5 giây." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unlocking early takes a tongue twister. Real emergency? Hold the button 5 seconds." } } } },
    "SayBeer dùng Screen Time của Apple để khóa app bạn chọn." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "SayBeer uses Apple's Screen Time to lock the apps you choose." } } } },
    "Không mạng, không tài khoản, không đọc tin nhắn hay dữ liệu — mọi thứ nằm trên máy." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No network, no accounts, no reading your messages or data — everything stays on your phone." } } } },
    "Tiếp tục" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue" } } } },
    "Đang xin quyền…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Requesting permission…" } } } },
    "Cho phép Screen Time & bắt đầu" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Screen Time & start" } } } },
    "Chọn app / nhóm app" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose apps / categories" } } } },
    "Chưa chọn" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "None selected" } } } },
    "%lld mục" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld items" } } } },
    "App cần khóa" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Apps to lock" } } } },
    "6h sáng" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "6 AM" } } } },
    "+4 giờ" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "+4 hrs" } } } },
    "+8 giờ" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "+8 hrs" } } } },
    "Tùy chọn" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom" } } } },
    "Khóa đến" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lock until" } } } },
    "Giờ mở khóa" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unlock time" } } } },
    "Mở khóa lúc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unlocks at" } } } },
    "Kèm tính nhẩm" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Include mental math" } } } },
    "Chặn xóa app trong phiên" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Block app deletion during session" } } } },
    "Tùy chọn phiên" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Session options" } } } },
    "Gõ chính xác câu líu lưỡi luôn là bắt buộc khi mở khóa sớm; tắt \"Kèm tính nhẩm\" nếu muốn bài kiểm tra chỉ gồm gõ câu. \"Chặn xóa app\" ngăn xóa mọi app (kể cả SayBeer) trong lúc khóa để khỏi né." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Typing the tongue twister exactly is always required to unlock early; turn off \"Include mental math\" to keep only the typing test. \"Block app deletion\" prevents deleting any app (including SayBeer) while locked, so there's no way around it." } } } },
    "Khóa ngay" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lock now" } } } },
    "Trong lúc khóa vẫn mở tạm được %lld phút để nhắn việc, tối đa %lld lần." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "While locked you can still open a %1$lld-minute work window, up to %2$lld times." } } } },
    "Chế độ nhậu" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Beer Mode" } } } },
    "Hủy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } } } },
    "chỉ nhắn việc, không tâm sự" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "work texts only, no feelings" } } } },
    "Mở %lld phút để nhắn việc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open %lld minutes for work texts" } } } },
    "Gõ đúng câu dưới đây để cam kết:" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Type this exactly to commit:" } } } },
    "“%@”" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@”" } } } },
    "Gõ lại câu trên…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Type it here…" } } } },
    "Hít thở đã… %llds" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Breathe… %llds" } } } },
    "Mở cửa sổ nhắn việc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open work window" } } } },
    "Còn %lld lần mở trong cuộc nhậu này" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld opens left this session" } } } },
    "Thôi" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Never mind" } } } },
    "Thôi, để khóa tiếp" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep it locked" } } } },
    "Kiểm tra tỉnh táo" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sobriety check" } } } },
    "Gõ chính xác câu sau (đúng cả dấu)" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Type this exactly (every letter counts)" } } } },
    "Tính nhẩm" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mental math" } } } },
    "%lld + %lld =" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$lld + %2$lld =" } } } },
    "Chưa đúng. Say thì đi ngủ đi." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Nope. You're drunk — go to sleep." } } } },
    "Mở khóa" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unlock" } } } },
    "Hết giờ — thử lại từ đầu." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Time's up — start over." } } } },
    "Sai 3 lần rồi" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Three strikes" } } } },
    "Nghỉ %lld:%@ nữa rồi thử lại.\nHoặc cứ để khóa đến giờ hẹn cho lành." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest %1$lld:%2$@ and try again.\nOr just let it unlock on schedule." } } } },
    "Mở khóa khẩn cấp" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Emergency unlock" } } } },
    "Gỡ khóa toàn bộ app ngay lập tức, không kiểm tra, không giới hạn.\nChỉ dùng khi có việc khẩn thật sự — kết thúc luôn chế độ nhậu." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unlocks everything instantly — no test, no limits.\nFor real emergencies only. Ends Beer Mode entirely." } } } },
    "Giữ %lld giây để mở khóa" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold %lld seconds to unlock" } } } },
    "Giữ tiếp… %llds" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep holding… %llds" } } } },
    "Nhả tay là tính lại từ đầu." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Let go and it starts over." } } } },
    "Thôi, không khẩn" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not an emergency" } } } },
    "Đóng" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close" } } } },
    "Chưa có phiên nào kết thúc.\nNhậu một trận là có số liệu ngay." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No sessions finished yet.\nOne night out and you'll have numbers." } } } },
    "Khoe thành tích với hội nhậu" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show off to your drinking crew" } } } },
    "Chuỗi %lld phiên an toàn liên tiếp" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld safe sessions in a row" } } } },
    "Phiên an toàn" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Safe sessions" } } } },
    "Tổng giờ khóa" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hours locked" } } } },
    "Mở bằng kiểm tra" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Test unlocks" } } } },
    "Các phiên gần đây" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recent sessions" } } } },
    "%.0f giờ" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%.0f hrs" } } } },
    "%lld phút" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld min" } } } },
    "%lldg%@p" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$lldh%2$@m" } } } },
    " · %lld lần nhắn việc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : " · %lld work windows" } } } },
    "Trọn phiên" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Full session" } } } },
    "Mở sớm" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Early unlock" } } } },
    "Thành tích SayBeer" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "SayBeer stats" } } } },
    "SỐNG SÓT" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "SURVIVED" } } } },
    "%lld trận nhậu" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld nights out" } } } },
    "đã khóa máy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "phone locked" } } } },
    "chuỗi %lld" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld streak" } } } },
    "trận an toàn" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "safe in a row" } } } },
    "Tự khóa theo lịch" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto-lock on schedule" } } } },
    "Tới giờ hẹn, máy tự khóa danh sách app bên dưới — kể cả khi không mở SayBeer. Mở khóa sớm, cửa sổ nhắn việc và khẩn cấp hoạt động như phiên thường." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "At the scheduled time your phone locks the apps below — even if SayBeer isn't open. Early unlock, work windows and emergency all work as usual." } } } },
    "Ngày trong tuần" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Days of the week" } } } },
    "T2" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mon" } } } },
    "T3" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tue" } } } },
